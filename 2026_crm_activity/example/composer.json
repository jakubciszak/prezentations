{
    "name": "example/crm-activity-onboarding",
    "description": "CRM Activity archetype - Business Onboarding example",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "symfony/yaml": "^7.0",
        "symfony/messenger": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/console": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/config": "^7.0",
        "ramsey/uuid": "^4.7",
        "jakubciszak/rule-engine": "^1.3",
        "munusphp/munus": "^0.17.0",
        "symfony/framework-bundle": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    }
}
